{
  "name": "pinhal",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive weather map of Paraná, Brazil, built with Vue 3, TypeScript, and OpenLayers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "prepare:geodata": "python scripts/prepare_geodata.py",
    "collect:weather": "python scripts/weather_collector.py"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "ol": "^10.11.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
