# =============================================================================
# Pinhal — Git Ignore Configuration
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build & TypeScript outputs
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Environment variables & secrets (keep .env.example versioned)
.env
.env.*
!.env.example
*.local

# Python environments, caches & bytecode
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data pipeline temporary / atomic write artifacts
*.tmp
*.bak
public/data/*.tmp

# Test & coverage reports
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs & crash dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating System files (Windows, macOS, Linux)
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
